[Unit]
Description=Telegram Voting Bot Service (24/7)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/tg
ExecStart=/usr/bin/python3 /var/www/tg/bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
